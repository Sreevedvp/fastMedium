# fastMedium Environment Configuration

# Database
DATABASE_URL=sqlite:fastmedium.db

# SMTP Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=fastMedium <noreply@fastmedium.com>

# Local listener and browser origin (comma-separated exact origins)
API_HOST=127.0.0.1
API_PORT=8082
WEB_PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Required true when using HTTPS origins. Local HTTP needs false.
COOKIE_SECURE=false
AUTH_ATTEMPTS_PER_MINUTE=30
